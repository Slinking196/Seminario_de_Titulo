{
	"name": "Seminario de Titulo - Python 3.13 + LaTeX",
	"dockerComposeFile": "docker-compose.yml",
	"service": "workspace",
	"runServices": ["workspace", "latex"],
	"workspaceFolder": "/workspaces/Seminario_de_Titulo",
	"shutdownAction": "stopCompose",
	"features": {
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/nvidia-cuda:3": {}
	},
	"postCreateCommand": "if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"James-Yu.latex-workshop"
			]
		}
	}
}
